pipeline {
    agent any 
    stages {
        stage ('checkout') {
            steps {
                git branch: 'develop', url: 'https://github.com/mkranthi/kubernetes.git'
            }
        }
        stage('build image from Dockerfile') {
            steps {
                sh 'docker build -t practice-imageversion1 .'
            }
        }
        stage('tag the image') {
            steps {
                sh 'docker tag dpractice-imageversion1 kmannedev/practice-imageversion1:v1.0'
            }
        }
        stage('push the image') {
            steps {
                sh 'docker push kmannedev/practice-imageversion1:v1.0'
            }
        }
        stage('kubectl ') {
            steps {
                sh 'kubectl create -f deployment.yaml'
            }
        }
    }
}
